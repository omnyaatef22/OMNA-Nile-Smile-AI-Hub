      "id": "wa-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        880
      ]
    },
    {
      "parameters": {
        "jsCode": "// The WhatsApp Trigger hands us WhatsApp's \"change\" objects: contacts, messages and statuses.\n// Delivery and read receipts (statuses) are not customer messages, so only `messages` count.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const values = Array.isArray(j.entry) ? j.entry.flatMap(e => (e.changes || []).map(c => c.value || {})) : [j];\n  for (const v of values) {\n    if (!Array.isArray(v.messages)) continue;\n    const names = Object.fromEntries((v.contacts || []).map(c => [c.wa_id, c.profile?.name || '']));\n    for (const m of v.messages) {\n      const text = m.type === 'text' ? m.text?.body\n        : m.type === 'button' ? m.button?.text\n        : m.type === 'interactive' ? (m.interactive?.button_reply?.title || m.interactive?.list_reply?.title)\n        : (m[m.type]?.caption || '');\n      out.push({ json: { dedup_key: `whatsapp:${m.id}`, core: {\n        channel: 'whatsapp', channel_user_id: m.from, message_id: m.id, text: text || '',\n        message_type: text ? 'text' : m.type, customer_name: names[m.from] || '',\n        received_at: new Date(Number(m.timestamp) * 1000).toISOString() } } });\n    }\n  }\n}\nreturn out;"
      },
      "id": "extract-whatsapp-messages",
      "name": "Extract WhatsApp Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        880
      ]
    }
