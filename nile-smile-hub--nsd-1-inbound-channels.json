    {
      "parameters": {
        "jsCode": "// One bot = one webhook. Customers, staff commands and button clicks all arrive here,\n// so we sort them before anything else happens.\nconst cfg = $('Get Config').first().json;\nconst u = $('Telegram Trigger').first().json;\nconst staff = String(cfg.STAFF_CHAT_ID || '');\nconst fullName = f => [f?.first_name, f?.last_name].filter(Boolean).join(' ');\n\nif (u.callback_query) {\n  const q = u.callback_query;\n  const chatId = String(q.message?.chat?.id ?? '');\n  if (!staff || chatId !== staff) return [{ json: { kind: 'ignore', reason: 'button outside staff group' } }];\n  return [{ json: { kind: 'staff_callback', payload: {\n    callback_query_id: q.id, data: q.data, from_name: fullName(q.from), from_username: q.from?.username || '',\n    chat_id: chatId, message_id: q.message?.message_id, message_text: q.message?.text || '' } } }];\n}\n\nconst m = u.message;\nif (!m) return [{ json: { kind: 'ignore', reason: 'unsupported update type' } }];\nconst chatId = String(m.chat.id);\nconst text = String(m.text || m.caption || '').trim();\n\nif (m.chat.type !== 'private') {\n  if (/^\\/groupid\\b/i.test(text)) return [{ json: { kind: 'groupid', chat_id: chatId, chat_title: m.chat.title || '' } }];\n  if (staff && chatId === staff && text.startsWith('/')) return [{ json: { kind: 'staff_command', payload: {\n    text, chat_id: chatId, message_id: m.message_id, from_name: fullName(m.from), from_username: m.from?.username || '' } } }];\n  return [{ json: { kind: 'ignore', reason: 'group chatter' } }];\n}\nif (m.from?.is_bot) return [{ json: { kind: 'ignore', reason: 'bot message' } }];\n\nlet type = 'text';\nif (!text) type = m.photo ? 'image' : m.voice ? 'voice' : m.audio ? 'audio' : m.video ? 'video'\n  : m.document ? 'document' : m.sticker ? 'sticker' : m.location ? 'location' : 'other';\nreturn [{ json: { kind: 'customer', dedup_key: `telegram:${chatId}:${m.message_id}`, core: {\n  channel: 'telegram', channel_user_id: chatId, message_id: String(m.message_id),\n  text: /^\\/start\\b/i.test(text) ? 'Hello' : text, message_type: type,\n  customer_name: fullName(m.from), received_at: new Date(m.date * 1000).toISOString() } } }];"
      },
