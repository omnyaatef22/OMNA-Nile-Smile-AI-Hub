    {
      "parameters": {
        "jsCode": "// Messenger and Instagram share one webhook URL. The payload's `object` tells them apart:\n// \"page\" = Facebook Messenger, \"instagram\" = Instagram DMs. Echoes are copies of OUR replies: skip them.\nconst body = $('Incoming Events (POST)').first().json.body || {};\nconst channel = { page: 'messenger', instagram: 'instagram' }[body.object];\nif (!channel) return [];\nconst out = [];\nfor (const entry of body.entry || []) {\n  for (const ev of entry.messaging || []) {\n    const m = ev.message;\n    if (!m || m.is_echo || m.is_deleted) continue;\n    if (String(ev.sender?.id) === String(entry.id)) continue;\n    const text = m.text || m.quick_reply?.payload || '';\n    const type = text ? 'text' : (m.attachments?.[0]?.type || 'other');\n    out.push({ json: { dedup_key: `${channel}:${m.mid}`, core: {\n      channel, channel_user_id: String(ev.sender.id), message_id: m.mid, text,\n      message_type: type, customer_name: '', received_at: new Date(Number(ev.timestamp)).toISOString() } } });\n  }\n}\nreturn out;"
      },
      "id": "n241",
      "name": "Extract Messenger & Instagram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        1460
      ]
    },
